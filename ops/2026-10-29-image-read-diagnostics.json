  "scope": "Add privacy-safe diagnostics to main-thread image fetch/body-read/bitmap-decode failures. No conversion/render/cache policy changes.",
  "changes": {
    "memory": [
      "memory_api",
      "js_heap_used_bytes",
      "js_heap_total_bytes",
      "js_heap_limit_bytes",
      "device_memory_gb"
    ],
    "cache": [
      "total_pages",
      "cached_pages",
      "cached_original_chars",
      "cached_display_chars",
      "cached_variant_chars",
      "cached_variant_count",
      "cached_data_url_chars",
      "cached_blob_bytes",
      "cache_incomplete",
      "cache_snapshot_status"
    ],
    "classification": [
      "out_of_memory",
      "security_error",
      "quota_exceeded",
      "invalid_state",
      "fetch_failed",
      "body_read_failed",
      "bitmap_decode_failed",
      "other"
    ],
    "reporting": "Existing pdf_image_processing context gains safe scalar metrics. image_error_hint tag and image-read/step/hint fingerprint distinguish new failures. Existing historical events cannot be enriched retroactively.",
    "sampling": "Cache and memory probes execute only after a non-cancelled image read failure. Reader uses the live initial-render/variant arrays; exporter uses accumulated output Blobs. All probe failures preserve original error identity."
  },
  "privacy": [
    "No file names, raw source data URLs, PDF text, image bytes or raw exception messages are added to diagnostics.",
    "Only fixed-enum classifications and bounded scalar counters are emitted.",
    "No document buffers are copied, decoded or retained for logging."
  ],
  "limitations": [
    "performance.memory is optional and legacy. JS heap counters are not total tab/device/canvas/GPU/Worker resident memory. Unavailable metrics are omitted, never invented as zero.",
    "device_memory_gb is browser-reported coarse capacity, not free RAM. Cache characters are logical payload characters, not physical memory bytes; aliases are de-duplicated only within a page.",
    "out_of_memory is a bounded error-message hint, not proof of OS OOM. A process killed before JavaScript handles the failure cannot guarantee a report.",
    "Chrome/WebKit desktop testing is not a real Android/iPhone device test. Local browser QA isolates third-party HTTPS ads/analytics for both builds; production settings were unchanged.",
    "Failure branch tests use local unit doubles and mocked Sentry only. No simulated error was injected into production or production reporting.",
    "The earlier working-tree checks include separate client-diagnostics work. Exact release checks exclude that work, which remains untouched locally."
  ],
  "documentation": [
    "https://developer.mozilla.org/en-US/docs/Web/API/Performance/memory",
    "https://developer.mozilla.org/en-US/docs/Web/API/Navigator/deviceMemory"
  ],
